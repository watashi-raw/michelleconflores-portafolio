// video
function vcard(v) {
  const w = el('div');
  const box = el('div', {class: 'vid ' + v.fmt});
  const vid = el('video', {src: v.src, poster: v.poster, preload: 'none', playsinline: '', controls: ''});
  vid.controls = false;
  const p = el('button', {class: 'play', type: 'button', 'aria-label': `Reproducir ${v.nombre}`}, '<i></i>');
  p.onclick = () => { document.querySelectorAll('video').forEach(o => { if (o !== vid) o.pause(); }); vid.controls = true; p.remove(); vid.play().catch(() => {}); };
  box.append(vid, p);
  w.append(box, el('div', {class: 'cap'}, `<b>${esc(v.nombre)}</b><span>${esc(v.que)}</span>`));
  return w;
}
