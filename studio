// visor
let LB = [], LBi = 0;
const dlg = $('#lb');
function show() { const it = LB[LBi]; $('#lbimg').src = it.src; $('#lbimg').alt = it.alt || ''; $('#lbcap').innerHTML = it.cap || ''; $('#lbprev').hidden = $('#lbnext').hidden = LB.length < 2; }
function openLB(items, i) { LB = items; LBi = i; show(); if (!dlg.open) dlg.showModal(); }
$('#lbprev').onclick = () => { LBi = (LBi - 1 + LB.length) % LB.length; show(); };
$('#lbnext').onclick = () => { LBi = (LBi + 1) % LB.length; show(); };
$('#lbclose').onclick = () => dlg.close();
dlg.addEventListener('click', e => { if (e.target === dlg) dlg.close(); });
document.addEventListener('keydown', e => { if (!dlg.open) return; if (e.key === 'ArrowRight') $('#lbnext').click(); if (e.key === 'ArrowLeft') $('#lbprev').click(); });

