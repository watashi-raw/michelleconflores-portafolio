<style>
/* Portafolio de una sola página sobre azul profundo (esencia de la marca); la sección «Cómo trabajo» va en tema claro porque explica. Flores reales en las orillas. */
:root{
  color-scheme: dark;
  --noche:#0B1260; --azul:#1221E5; --indigo:#2A0ED9; --rosa:#FF25A1; --coral:#FF6534; --mandarina:#FF8A2B;
  --lila:#CCAEFE; --crema:#FAF2E5; --mute:#C3C5F2; --ink:#14123A; --ink-mute:#55536E;
  --card:rgba(255,255,255,.06); --line:rgba(204,174,254,.22);
  --display:"DM Serif Display",Georgia,serif; --sans:"Quicksand",system-ui,-apple-system,"Segoe UI",sans-serif; --goudy:"Sorts Mill Goudy",Georgia,serif;
  --gutter:clamp(16px,4.5vw,64px); --max:1280px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:84px}
body{margin:0;background:#080C45;color:var(--crema);font-family:var(--sans);font-size:17px;line-height:1.6;font-weight:500;overflow-x:hidden;
  background-image:radial-gradient(ellipse 60% 40% at 85% 0%,rgba(255,37,161,.22),transparent 70%),radial-gradient(ellipse 50% 30% at 0% 45%,rgba(255,101,52,.14),transparent 70%),linear-gradient(180deg,#0B1260 0%,#101AA8 40%,#0B1260 100%)}
img,video{display:block;max-width:100%;height:auto}
a{color:inherit}
:focus-visible{outline:2px solid var(--lila);outline-offset:3px;border-radius:6px}
.wrap{max-width:var(--max);margin:0 auto;padding-inline:var(--gutter)}
.eb{font-weight:700;font-size:13px;letter-spacing:.24em;text-transform:uppercase;color:var(--mandarina);margin:0}
h1,h2,h3{font-family:var(--display);font-weight:400;margin:0;text-wrap:balance;line-height:1.04}
h2{font-size:clamp(36px,5vw,64px)}
h2 em,h1 em{font-style:italic;color:var(--rosa)} h2 em.n{color:var(--coral)}
.lede{color:var(--mute);font-size:clamp(17px,1.6vw,20px);max-width:58ch;margin:0}
section{position:relative;padding-block:clamp(64px,9vw,120px);overflow:hidden}
.shead{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.9fr);gap:24px 56px;align-items:end;margin-bottom:clamp(28px,4vw,48px)}
.shead .t{display:flex;flex-direction:column;gap:14px}
@media (max-width:860px){.shead{grid-template-columns:1fr}}
.flor{position:absolute;pointer-events:none;z-index:0;filter:drop-shadow(0 0 26px rgba(255,140,200,.4))}
section > .wrap{position:relative;z-index:1}
@media (max-width:700px){section > .flor{display:none}}
.btn{display:inline-flex;align-items:center;gap:10px;border-radius:99px;padding:14px 26px;font-weight:700;font-size:16px;text-decoration:none;border:1.5px solid transparent;cursor:pointer;font-family:var(--sans)}
.btn.p{background:var(--rosa);color:#fff}
.btn.p:hover{background:#ff3fae}
.btn.o{border-color:rgba(250,242,229,.45);color:var(--crema);background:transparent}
.btn.o:hover{border-color:var(--crema)}

/* barra */
.bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:40;background:rgba(9,13,70,.78);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.bar .wrap{display:flex;align-items:center;justify-content:space-between;gap:20px;height:68px}
.bar img{height:40px;width:auto}
.nav{display:flex;align-items:center;gap:26px;font-size:15px;font-weight:600}
.nav a{text-decoration:none;color:var(--mute)} .nav a:hover{color:var(--crema)}
.nav .btn{padding:10px 20px;font-size:15px;color:#fff}
@media (max-width:980px){.nav a:not(.btn){display:none}}

/* portada */
.hero{padding-block:clamp(48px,8vw,104px) clamp(56px,8vw,110px);overflow:hidden}
.hero .wrap{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,.92fr);gap:48px;align-items:center}
@media (max-width:900px){.hero .wrap{grid-template-columns:1fr}}
.hero h1{font-size:clamp(46px,6.6vw,92px);margin:18px 0 22px}
.hero .who{font-family:var(--goudy);font-style:italic;font-size:clamp(20px,2vw,26px);color:var(--coral)}
.hero .ctas{display:flex;flex-wrap:wrap;gap:14px;margin-top:30px}
.rise{animation:rise .8s cubic-bezier(.2,.7,.2,1) both}
.d1{animation-delay:.08s}.d2{animation-delay:.18s}.d3{animation-delay:.3s}.d4{animation-delay:.42s}.d5{animation-delay:.54s}
@keyframes rise{from{opacity:0;transform:translateY(26px)}to{opacity:1;transform:none}}
.fan{position:relative;aspect-ratio:1/1;max-width:560px;width:100%;justify-self:center}
.fan .c{position:absolute;border-radius:18px;overflow:hidden;box-shadow:0 24px 60px rgba(4,6,40,.55);border:1px solid rgba(255,255,255,.18)}
.fan .c img{width:100%;height:100%;object-fit:cover}
.fan .c1{width:54%;aspect-ratio:4/5;left:2%;top:14%;transform:rotate(-7deg)}
.fan .c2{width:50%;aspect-ratio:4/5;right:2%;top:4%;transform:rotate(6deg)}
.fan .c3{width:60%;aspect-ratio:16/10;left:22%;bottom:3%;transform:rotate(-1.5deg)}
.fan .tag{position:absolute;z-index:3;background:var(--crema);color:var(--ink);font-weight:700;font-size:13px;letter-spacing:.14em;text-transform:uppercase;padding:8px 14px;border-radius:99px}

/* marcas */
.logos{padding-block:28px;border-block:1px solid var(--line);overflow:hidden;background:rgba(5,8,46,.35)}
.logos .lbl{text-align:center;margin-bottom:18px}
.marquee{display:flex;gap:18px;width:max-content;animation:slide 48s linear infinite}
.marquee img{height:84px;width:84px;object-fit:contain;border-radius:16px;background:#fff;flex:none}
@keyframes slide{to{transform:translateX(-50%)}}
@media (prefers-reduced-motion:reduce){.marquee{animation:none;flex-wrap:wrap;width:auto;justify-content:center}.rise{animation:none}}

/* servicios */
.serv{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
@media (max-width:980px){.serv{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:640px){.serv{grid-template-columns:1fr}}
.sv{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:26px 26px 24px;display:flex;flex-direction:column;gap:10px}
.sv h3{font-size:30px}
.sv h3 span{color:var(--rosa)} .sv:nth-child(even) h3 span{color:var(--coral)}
.sv p{margin:0;color:var(--mute)}
.sv ul{margin:6px 0 0;padding:0;list-style:none;display:flex;flex-wrap:wrap;gap:8px}
.sv li{font-size:13.5px;font-weight:700;padding:5px 12px;border-radius:99px;border:1px solid var(--line);color:var(--crema)}
.sv a{margin-top:auto;padding-top:10px;font-weight:700;font-size:15px;color:var(--lila);text-decoration:none}
.sv a:hover{color:var(--crema)}

/* marcas (casos) */
.cases{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
@media (max-width:980px){.cases{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:600px){.cases{grid-template-columns:1fr}}
.case{all:unset;cursor:pointer;display:flex;flex-direction:column;gap:12px;border-radius:20px}
.case .cv{aspect-ratio:4/3;border-radius:18px;overflow:hidden;background:rgba(255,255,255,.06);border:1px solid var(--line);position:relative}
.case .cv img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.case:hover .cv img{transform:scale(1.04)}
.case .n{position:absolute;right:12px;bottom:12px;background:rgba(9,13,70,.82);border-radius:99px;padding:5px 12px;font-size:13px;font-weight:700}
.case h3{font-size:26px}
.case p{margin:0;color:var(--mute);font-size:15.5px;line-height:1.45}
.case .tg{font-size:12.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--mandarina)}
.case:focus-visible{outline:2px solid var(--lila);outline-offset:6px}

/* campañas */
.camp-top{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:22px;margin-bottom:34px}
@media (max-width:860px){.camp-top{grid-template-columns:1fr}}
.steps{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}
@media (max-width:980px){.steps{grid-template-columns:repeat(2,minmax(0,1fr))}}
.st{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:18px}
.st b{display:block;font-family:var(--display);font-weight:400;font-size:22px;line-height:1.1;margin-bottom:6px}
.st span{font-size:14.5px;color:var(--mute);line-height:1.45;display:block}
.tabs{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:12px}
.tab{font-family:var(--sans);font-weight:700;font-size:15px;padding:10px 18px;border-radius:99px;border:1.5px solid var(--line);background:transparent;color:var(--mute);cursor:pointer}
.tab[aria-selected="true"]{background:var(--crema);color:var(--ink);border-color:var(--crema)}
.tabq{color:var(--mute);margin:0 0 22px;min-height:1.6em}
.ads{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
@media (max-width:980px){.ads{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media (max-width:600px){.ads{grid-template-columns:repeat(2,minmax(0,1fr))}}
.ad{all:unset;cursor:pointer;display:flex;flex-direction:column;gap:8px}
.ad .im{aspect-ratio:4/5;border-radius:14px;overflow:hidden;background:#fff;border:1px solid var(--line)}
.ad img{width:100%;height:100%;object-fit:cover}
.ad span{font-size:13px;font-weight:700;color:var(--mute);letter-spacing:.06em}
.ad:focus-visible .im{outline:2px solid var(--lila);outline-offset:3px}
.nota{margin-top:22px;font-size:14px;color:var(--mute)}

/* video */
.feat{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:28px;align-items:center;margin-bottom:28px}
@media (max-width:860px){.feat{grid-template-columns:1fr}}
.vid{position:relative;border-radius:18px;overflow:hidden;background:#05082E;border:1px solid var(--line)}
.vid video{width:100%;height:100%;object-fit:cover}
.vid.h{aspect-ratio:16/9} .vid.v{aspect-ratio:9/16}
.vid .play{all:unset;position:absolute;inset:0;display:grid;place-items:center;cursor:pointer;background:linear-gradient(180deg,rgba(5,8,46,0) 50%,rgba(5,8,46,.75))}
.vid .play i{width:74px;height:74px;border-radius:50%;background:rgba(250,242,229,.92);display:grid;place-items:center;box-shadow:0 10px 30px rgba(0,0,0,.35)}
.vid .play i::before{content:"";border-left:22px solid var(--indigo);border-block:13px solid transparent;margin-left:6px}
.vid .play:focus-visible i{outline:3px solid var(--lila);outline-offset:4px}
.reels{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px}
@media (max-width:980px){.reels{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media (max-width:600px){.reels{grid-template-columns:repeat(2,minmax(0,1fr))}}
.cap{display:flex;flex-direction:column;gap:2px;margin-top:10px}
.cap b{font-family:var(--display);font-weight:400;font-size:21px}
.cap span{font-size:14px;color:var(--mute);line-height:1.4}

/* fotografía */
.fotos{columns:3 300px;column-gap:16px}
.ft{all:unset;cursor:pointer;display:block;break-inside:avoid;margin-bottom:16px;border-radius:16px;overflow:hidden;position:relative;border:1px solid var(--line)}
.ft img{width:100%}
.ft span{position:absolute;left:12px;bottom:12px;background:rgba(9,13,70,.8);border-radius:99px;padding:5px 12px;font-size:13px;font-weight:700}
.ft:focus-visible{outline:2px solid var(--lila);outline-offset:3px}

/* web */
.webs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
@media (max-width:860px){.webs{grid-template-columns:1fr}}
.wb{all:unset;cursor:pointer;display:flex;flex-direction:column;gap:10px}
.wb .im{aspect-ratio:4/3;border-radius:16px;overflow:hidden;border:1px solid var(--line);background:#fff}
.wb img{width:100%;height:100%;object-fit:cover;object-position:top}

/* cómo trabajo (tema claro) */
.claro{background:linear-gradient(135deg,#F6F3FF,#FAF2E5 55%,#FFF0F7);color:var(--ink)}
.claro::before{content:"";position:absolute;left:0;right:0;top:0;height:5px;background:linear-gradient(90deg,#1221E5,#FF25A1 55%,#FF6534)}
.claro h2{color:var(--indigo)} .claro .lede{color:var(--ink-mute)} .claro .eb{color:var(--rosa)}
.flow{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;counter-reset:p}
@media (max-width:900px){.flow{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:520px){.flow{grid-template-columns:1fr}}
.fl{background:#fff;border:1px solid #E4DEF3;border-radius:20px;padding:24px;box-shadow:0 10px 30px rgba(42,14,217,.06)}
.fl .k{font-family:var(--display);font-size:46px;line-height:1;color:var(--rosa)}
.fl h3{font-size:26px;color:var(--indigo);margin:10px 0 8px}
.fl p{margin:0;color:var(--ink);font-size:16px;line-height:1.5}
.claro .flor{filter:drop-shadow(0 10px 18px rgba(42,14,217,.14))}

/* cotiza */
.cot{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:48px;align-items:start}
@media (max-width:900px){.cot{grid-template-columns:1fr}}
.contacto{display:flex;flex-direction:column;gap:12px;margin-top:28px}
.ci{display:flex;align-items:center;justify-content:space-between;gap:12px;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px 18px;flex-wrap:wrap}
.ci .l{font-size:12.5px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--mandarina)}
.ci .v{font-weight:700;user-select:all;word-break:break-word}
.mini{font-family:var(--sans);font-weight:700;font-size:13.5px;padding:7px 14px;border-radius:99px;border:1px solid var(--line);background:transparent;color:var(--crema);cursor:pointer;text-decoration:none}
.mini:hover{border-color:var(--crema)}
form{background:rgba(5,8,46,.5);border:1px solid var(--line);border-radius:24px;padding:clamp(20px,3vw,32px);display:flex;flex-direction:column;gap:20px}
fieldset{border:0;padding:0;margin:0;display:flex;flex-direction:column;gap:10px;min-width:0}
legend{font-weight:700;font-size:13px;letter-spacing:.2em;text-transform:uppercase;color:var(--lila);margin-bottom:10px;padding:0}
.chips{display:flex;flex-wrap:wrap;gap:10px}
.chips label{position:relative}
.chips input{position:absolute;opacity:0;inset:0;cursor:pointer;margin:0}
.chips span{display:inline-block;padding:10px 16px;border-radius:99px;border:1.5px solid var(--line);font-weight:700;font-size:15px;color:var(--mute)}
.chips input:checked + span{background:var(--rosa);border-color:var(--rosa);color:#fff}
.chips input:focus-visible + span{outline:2px solid var(--lila);outline-offset:3px}
.fld{display:flex;flex-direction:column;gap:8px}
.fld label{font-weight:700;font-size:14px;color:var(--mute)}
.fld input,.fld textarea{font:inherit;font-size:16px;color:var(--crema);background:rgba(255,255,255,.06);border:1.5px solid var(--line);border-radius:14px;padding:12px 14px}
.fld textarea{min-height:96px;resize:vertical}
.fld input:focus,.fld textarea:focus{outline:none;border-color:var(--lila)}
.prev{font-size:15px;color:var(--mute);background:rgba(255,255,255,.04);border:1px dashed var(--line);border-radius:14px;padding:14px 16px;white-space:pre-wrap;margin:0}
.acts{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
.ok{font-size:14px;color:var(--lila);min-height:1.4em}

footer{padding-block:56px;border-top:1px solid var(--line);text-align:center;display:flex;flex-direction:column;align-items:center;gap:16px}
footer img{height:64px;width:auto}
footer p{margin:0}
footer .tl{font-family:var(--display);font-size:clamp(24px,3vw,34px);line-height:1.2}
footer .tl em{color:var(--coral)}
footer small{color:var(--mute)}

/* visor */
dialog{border:0;padding:0;background:transparent;max-width:min(1100px,94vw);width:100%;color:var(--crema)}
dialog::backdrop{background:rgba(4,6,36,.9);backdrop-filter:blur(6px)}
.lb{display:flex;flex-direction:column;gap:12px;align-items:center}
.lb img{max-height:78vh;width:auto;max-width:100%;border-radius:12px;background:#fff}
.lb .row{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;flex-wrap:wrap}
.lb .cap2{font-weight:700}
.lb .cap2 span{color:var(--mute);font-weight:500}
.lb .ctl{display:flex;gap:8px}
</style>

