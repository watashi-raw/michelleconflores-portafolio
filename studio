function msg() {
  const sv = [...document.querySelectorAll('input[name=servicio]:checked')].map(x => x.value);
  const et = (document.querySelector('input[name=etapa]:checked') || {}).value;
  const neg = $('#negocio').value.trim(), det = $('#detalle').value.trim();
  let m = 'Hola, Natasha. Vi tu portafolio de Michelle con Flores y quiero una cotización.';
  if (neg) m += `\nSoy: ${neg}`;
  if (sv.length) m += `\nMe interesa: ${sv.join(', ')}`;
  if (et) m += `\nEtapa: ${et}`;
  if (det) m += `\nDetalle: ${det}`;
  return m;
}
function upd() { const m = msg(); $('#prev').textContent = m; $('#wa').href = 'https://wa.me/525513609261?text=' + encodeURIComponent(m); }
$('#form').addEventListener('input', upd);
$('#form').addEventListener('submit', e => e.preventDefault());
document.querySelectorAll('.sv a[data-s]').forEach(a => a.addEventListener('click', () => {
  const i = SERV.indexOf(a.dataset.s); if (i >= 0) { $('#sv' + i).checked = true; upd(); }
}));
upd();

// copiar
function copy(text, done, fallbackEl) {
  const sel = () => { if (!fallbackEl) return; const r = document.createRange(); r.selectNodeContents(fallbackEl); const s = getSelection(); s.removeAllRanges(); s.addRange(r); done('Seleccionado: copia con ⌘C o Ctrl+C'); };
  try { navigator.clipboard.writeText(text).then(() => done('Copiado'), sel); } catch (e) { sel(); }
}
document.querySelectorAll('[data-copy]').forEach(b => b.addEventListener('click', () => {
  const t = document.getElementById(b.dataset.copy);
  copy(t.textContent, m => { b.textContent = m === 'Copiado' ? 'Copiado' : 'Selecciona'; setTimeout(() => b.textContent = 'Copiar', 1800); }, t);
}));
$('#copymsg').onclick = () => copy(msg(), m => { $('#ok').textContent = m; setTimeout(() => $('#ok').textContent = '', 2400); }, $('#prev'));
