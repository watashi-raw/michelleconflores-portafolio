const SERV = ['Consultoría de marca', 'Diseño de marca', 'Campañas Meta Ads', 'Contenido y video', 'Fotografía', 'Web y landings', 'Estrategia 360 completa'];
const ETAPA = ['Marca nueva', 'Renovar mi marca', 'Ya tengo marca, quiero crecer'];
